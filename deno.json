{
  "name": "@hzrd149/nsite-gateway",
  "version": "3.6.6",
  "exports": "./main.ts",
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns", "deno.unstable"]
  },
  "tasks": {
    "dev": "deno run --unstable-kv --env-file=.env --watch --allow-env --allow-net --allow-read --allow-write main.ts",
    "start": "deno run --unstable-kv --env-file=.env --allow-env --allow-net --allow-read --allow-write main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-env=DEBUG",
    "fmt": "deno fmt"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "applesauce-common": "npm:applesauce-common@^7.0.0",
    "applesauce-core": "npm:applesauce-core@^7.0.3",
    "applesauce-loaders": "npm:applesauce-loaders@^7.0.2",
    "applesauce-relay": "npm:applesauce-relay@^7.0.0",
    "applesauce-signers": "npm:applesauce-signers@^7.0.1",
    "debug": "npm:debug@^4.4.3",
    "rxjs": "npm:rxjs@^7.8.2",
    "xbytes": "npm:xbytes@^1.9.1"
  },
  "publish": {
    "include": [
      "public",
      "main.ts",
      "README.md",
      "LICENSE",
      "src",
      "nsite.md",
      "CHANGELOG.md"
    ]
  }
}
