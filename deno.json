{
  "name": "@hzrd149/nsite-gateway",
  "version": "3.6.7",
  "exports": "./main.ts",
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns", "deno.unstable"]
  },
  "tasks": {
    "dev": "deno run -P=gateway --unstable-kv --env-file=.env --watch main.ts",
    "start": "deno run -P=gateway --unstable-kv --env-file=.env main.ts",
    "start:public:ipv4": "deno run -P=gateway-public-ipv4 --no-prompt --unstable-kv --env-file=.env main.ts",
    "check": "deno check main.ts",
    "test": "deno test -P=test",
    "test:blob-cache": "deno test -P=test-blob-cache --unstable-kv src/services/integration/blob-cache.ts",
    "test:verified-cache": "deno test -P=test-blob-cache src/services/integration/verified-blob-cache.ts",
    "test:verified-network": "deno test -P=test-verified-network src/services/integration/verified-network.ts",
    "test:network": "deno test -P=test-network src/helpers/integration/native-network.ts",
    "fmt": "deno fmt"
  },
  "permissions": {
    "gateway": {
      "sys": ["uid"],
      "env": true,
      "net": true,
      "read": true,
      "write": true
    },
    "gateway-public-ipv4": {
      "sys": ["uid"],
      "env": true,
      "net": {
        "allow": true,
        "deny": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.0.2.0/24",
          "192.88.99.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "198.51.100.0/24",
          "203.0.113.0/24",
          "224.0.0.0/4",
          "240.0.0.0/4",
          "[::]",
          "[::1]"
        ]
      },
      "read": true,
      "write": true
    },
    "test": {
      "env": ["DEBUG", "NO_COLOR", "FORCE_COLOR", "TERM", "COLORTERM"]
    },
    "test-network": {
      "net": true,
      "run": ["deno"],
      "read": true,
      "write": true
    },
    "test-verified-network": {
      "sys": ["uid"],
      "net": ["127.0.0.1"],
      "read": true,
      "write": true
    },
    "test-blob-cache": {
      "sys": ["uid"],
      "env": true,
      "read": true,
      "write": true
    }
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.21",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "applesauce-common": "npm:applesauce-common@^7.1.1",
    "applesauce-core": "npm:applesauce-core@^7.1.3",
    "applesauce-loaders": "npm:applesauce-loaders@^7.3.0",
    "applesauce-relay": "npm:applesauce-relay@^7.1.1",
    "applesauce-signers": "npm:applesauce-signers@^7.2.0",
    "debug": "npm:debug@^4.4.3",
    "rxjs": "npm:rxjs@^7.8.2",
    "xbytes": "npm:xbytes@^1.9.1"
  },
  "publish": {
    "include": [
      "public",
      "main.ts",
      "README.md",
      "LICENSE",
      "src",
      "nsite.md",
      "CHANGELOG.md"
    ]
  }
}
