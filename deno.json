{
  "name": "@hzrd149/nsite-gateway",
  "version": "3.6.5",
  "exports": "./main.ts",
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns", "deno.unstable"]
  },
  "tasks": {
    "dev": "deno run --unstable-kv --env-file=.env --watch --allow-env --allow-net --allow-read --allow-write main.ts",
    "start": "deno run --unstable-kv --env-file=.env --allow-env --allow-net --allow-read --allow-write main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.12.28",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "applesauce-common": "npm:applesauce-common@^6.2.0",
    "applesauce-core": "npm:applesauce-core@^6.2.0",
    "applesauce-loaders": "npm:applesauce-loaders@^6.2.0",
    "applesauce-relay": "npm:applesauce-relay@^6.2.1",
    "applesauce-signers": "npm:applesauce-signers@^6.2.2",
    "debug": "npm:debug@^4.4.3",
    "rxjs": "npm:rxjs@^7.8.2",
    "xbytes": "npm:xbytes@^1.9.1"
  },
  "publish": {
    "include": [
      "public",
      "main.ts",
      "README.md",
      "LICENSE",
      "src",
      "nsite.md",
      "CHANGELOG.md"
    ]
  }
}
